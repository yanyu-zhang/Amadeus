DISCORD_TOKEN=
# Optional: sync commands instantly to a development server.
DISCORD_GUILD_ID=
DEFAULT_TIMEZONE=America/Los_Angeles
# Local-only speech recognition and meeting summaries.
ASR_MODEL=mlx-community/Qwen3-ASR-1.7B-4bit
# Skip VAD spans with RMS below this dBFS level; original WAVs are retained.
ASR_MIN_RMS_DBFS=-40
MEETING_VOCABULARY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
MAX_RECORDING_MB=2048
# Override only if automatic Opus discovery fails.
OPUS_LIBRARY=
# INFO shows meeting progress; DEBUG adds queue, model and chunk diagnostics.
LOG_LEVEL=INFO

# auto: think on long passages; true/false: force on/off.
SUMMARY_THINKING=auto
